rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════
// FIRESTORE SECURITY RULES  — Portfolio (moamenhamdanportfolio)
// ═══════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: is the caller the portfolio admin? ────────────────────
    function isAdmin() {
      return request.auth != null
          && request.auth.uid == "Kr7OQbxdBVWPtbAhfZH2nZZpSKq2";
    }

    // ── Helper: is a value a non-empty string under maxLen chars? ─────
    function isValidString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    // ══════════════════════════════════════════════════════════════════
    // PUBLIC PORTFOLIO COLLECTIONS
    // Anyone can read; only the admin can write/delete.
    // ══════════════════════════════════════════════════════════════════

    match /projects/{docId} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    match /skills/{docId} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    match /certificates/{docId} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    match /testimonials/{docId} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    match /siteSettings/{docId} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    match /blogPosts/{docId} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════
    // CONTACT FORM — messages collection
    // ══════════════════════════════════════════════════════════════════
    match /messages/{docId} {
      allow create: if
        request.resource.data.keys().hasAll(['name', 'email', 'message', 'timestamp'])
        && isValidString(request.resource.data.name, 100)
        && request.resource.data.name.size() >= 2
        && isValidString(request.resource.data.email, 320)
        && isValidString(request.resource.data.message, 2000)
        && request.resource.data.message.size() >= 10
        && request.resource.data.keys().size() == 4;

      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // ══════════════════════════════════════════════════════════════════
    // COMMENTS — portfolio-comments collection
    // Fix: serverTimestamp() cannot be validated before write,
    // so we only validate userName and content fields.
    // profileImage is optional (base64 or Storage URL or null).
    // ══════════════════════════════════════════════════════════════════
    match /portfolio-comments/{docId} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasAll(['userName', 'content', 'createdAt'])
        && isValidString(request.resource.data.userName, 100)
        && isValidString(request.resource.data.content, 2000);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Legacy comments collection (unused but kept for safety)
    match /comments/{docId} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasAll(['name', 'text', 'timestamp'])
        && isValidString(request.resource.data.name, 100)
        && isValidString(request.resource.data.text, 1000);
      allow update, delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════
    // DEFAULT DENY
    // ══════════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
